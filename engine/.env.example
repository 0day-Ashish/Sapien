# Copy to engine/.env.local (gitignored). Never commit real keys.
# Deposit Account key (ADR-0004). Protocol-owned, separate from personal accounts.
DEPOSIT_ACCOUNT_PRIVATE_KEY=
# Execution Engine operator on HyperEVM: Vault engine, and (testnet custody) owner of the Vaults it creates.
ENGINE_OPERATOR_PRIVATE_KEY=

# NEAR (testnet): the Sapien Contract and the engine's Function-Call Key (near/README.md).
NEAR_NETWORK=testnet
# Default https://rpc.testnet.near.org; https://test.rpc.fastnear.com is always the fallback.
NEAR_RPC_URL=
NEAR_CONTRACT=sapien-vault.testnet
NEAR_ENGINE_ACCOUNT=engine.sapien-vault.testnet
NEAR_ENGINE_PRIVATE_KEY=
# The NEAR account whose Vault the runner trades (Kill Switch, Decision Commitments), if it isn't in .data/near-vaults.json.
RUNNER_NEAR_ACCOUNT=
# smoke:near, read-only: a NEAR account to inspect.
NEAR_SMOKE_ACCOUNT=
